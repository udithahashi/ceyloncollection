# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit real secrets.
# .env.example, docker/.env.production.example and docker/.env.data.example are
# committed on purpose so required variables are documented; all three must only
# ever contain placeholders.
.env*
!.env.example
!docker/.env.production.example
!docker/.env.data.example

# TLS material for the data tier (docker/compose.data.yml). The private key of
# the database and cache; generated on the VPS and never anywhere else.
docker/certs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded lead reference images (local storage driver)
/storage

# test artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# generated brand assets are committed, but raw Higgsfield downloads are not
/reference/generated-raw

# brand-kit skill working state and draft generations - never final assets
/brandkit

# local tooling
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.local.log

# Scratch renders from the brand image scripts. 160MB of unreferenced source
# material; the finished assets live one level up in public/brand/.
public/brand/test/
