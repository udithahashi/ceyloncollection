# =============================================================================
# Ceylon Collection - environment template
# =============================================================================
# Copy this file to `.env.local` for development:
#     npm run setup
# ...or manually: copy .env.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed. This `.env.example`
# file is committed on purpose so you always know which variables are required -
# it must only ever contain placeholders, never real secrets.
#
# The app validates all of these at startup (src/lib/env). If one is missing or
# malformed the app refuses to boot and tells you exactly which one, instead of
# failing mysteriously later.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# WHERE this instance runs: `development` on your PC, `production` on the server.
#
# This is separate from NODE_ENV on purpose. Next.js forces NODE_ENV=production
# for every `next build`, including one you run locally, so NODE_ENV cannot tell
# "live server" from "local production build". APP_ENV can, and it is APP_ENV
# that switches on the strict production checks (HTTPS required, Redis required,
# no placeholder secrets).
#
# Setting this to `production` while APP_URL is http://localhost will correctly
# be rejected - and leaving it as `development` while APP_URL points at a real
# domain is rejected too, so it cannot be forgotten during deployment.
APP_ENV=development

# Public base URL of the app, no trailing slash.
APP_URL=http://localhost:3000

# Business timezone. Qatar is UTC+3 with no daylight saving. All timestamps are
# stored in UTC and converted to this zone for display and for grouping reports
# by day/week/month, so "today" means today in Doha, not in UTC.
APP_TIMEZONE=Asia/Qatar

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string.
# Locally this points at the Docker container from docker/compose.dev.yml,
# which listens on port 5433 (not the default 5432) to avoid collisions.
DATABASE_URL=postgresql://ceylon:CHANGE_ME@localhost:5433/ceyloncollection

# These three are read by Docker Compose when it creates the local database
# container. They must match the credentials inside DATABASE_URL above.
POSTGRES_USER=ceylon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ceyloncollection

# --- Cache / rate limiting ----------------------------------------------------
# Redis backs session caching and rate limiting. You never write Redis commands
# yourself; it is infrastructure, not something you maintain.
REDIS_URL=redis://localhost:6380

# Escape hatch: set to `true` to run with no Redis at all, using an in-memory
# fallback instead. Handy if Docker is unavailable on your machine. Never enable
# this in production - in-memory limits reset on every restart and are not
# shared between processes.
DISABLE_REDIS=false

# --- Authentication -----------------------------------------------------------
# Signing secret for sessions. Minimum 32 characters.
# Generate a fresh one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a DIFFERENT value in production than in development.
BETTER_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS
BETTER_AUTH_URL=http://localhost:3000

# --- File storage -------------------------------------------------------------
# `local` writes lead reference images to the directory below. Switch to `s3`
# later for S3 / Cloudflare R2 / Contabo Object Storage without code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads

# --- n8n integration ----------------------------------------------------------
# Shared secret used to HMAC-sign requests from n8n into the lead intake
# endpoint. Must match the value configured in the n8n credential.
# Generate with the same command as BETTER_AUTH_SECRET.
N8N_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS

# --- Observability ------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Optional. Leave blank to disable error reporting.
SENTRY_DSN=
