{
  "name": "ceyloncollection",
  "version": "0.1.0",
  "private": true,
  "description": "Ceylon Collection - lead intelligence back office",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname,app",
    "build": "next build",
    "start": "next start",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "dev:up": "docker compose --env-file .env.local -f docker/compose.dev.yml up -d",
    "dev:down": "docker compose --env-file .env.local -f docker/compose.dev.yml down",
    "dev:logs": "docker compose --env-file .env.local -f docker/compose.dev.yml logs -f",
    "dev:status": "docker compose --env-file .env.local -f docker/compose.dev.yml ps",
    "dev:destroy": "docker compose --env-file .env.local -f docker/compose.dev.yml down -v",
    "dev:reset": "npm run dev:destroy && npm run dev:up && node scripts/wait-for-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "auth:create-owner": "tsx scripts/create-owner.mts",
    "auth:probe": "tsx scripts/auth-probe.mts",
    "auth:schema-check": "better-auth generate --config src/lib/auth/index.ts --output .next/auth-schema-check.ts -y",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "better-auth": "^1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
