# =============================================================================
# Ceylon Collection - production compose environment
# =============================================================================
# Copy this file to `.env.production` at the REPO ROOT (not inside docker/) and
# fill in real values:
#     cp docker/.env.production.example .env.production
#
# `.env.production` is git-ignored and must NEVER be committed - this example
# file is committed on purpose so every required variable is documented, and
# it must only ever contain placeholders.
#
# Used with:
#     docker compose --env-file .env.production -f docker/compose.prod.yml ...
#
# This is a different file from `.env.example` at the repo root on purpose:
# that one is the app's own config, validated by src/lib/env at startup, and
# is meant for `npm run dev`/`npm run build` running natively. This file is
# read by Docker Compose itself, to fill in the `${...}` placeholders in
# docker/compose.prod.yml - some values here (POSTGRES_PASSWORD,
# REDIS_PASSWORD) never reach the app directly; compose assembles them into
# DATABASE_URL/REDIS_URL for the `app` service's environment.
# =============================================================================

# --- Image ---------------------------------------------------------------
# Which image to pull/build and which tag. GitHub Actions publishes
# IMAGE_TAG=<git sha> on every push to main; IMAGE_TAG=latest tracks main.
IMAGE_REPO=ghcr.io/udithahashi/ceyloncollection
IMAGE_TAG=latest

# --- App -------------------------------------------------------------------
# The real public URL. Must be https:// - src/lib/env rejects a production
# instance whose APP_URL is not HTTPS, because session cookies are Secure-only.
APP_URL=https://CHANGE_ME.example.com
APP_TIMEZONE=Asia/Qatar

# Generate both with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use DIFFERENT values than development. BETTER_AUTH_SECRET signs sessions;
# N8N_WEBHOOK_SECRET must match the Header Auth credential in production n8n.
BETTER_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS
N8N_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS

LOG_LEVEL=info
SENTRY_DSN=

# --- Database ----------------------------------------------------------------
# Compose creates the `db` container with these, and assembles DATABASE_URL
# for `app` from the same values - keep them here, not duplicated elsewhere.
POSTGRES_USER=ceylon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ceyloncollection

# --- Cache / rate limiting -----------------------------------------------------
# Unlike local dev, production Redis requires a password - `DISABLE_REDIS` is
# hard-rejected in production (src/lib/env/schema.ts), so this is not optional.
REDIS_PASSWORD=CHANGE_ME

# --- Reverse proxy / TLS -------------------------------------------------------
# The domain Caddy requests a Let's Encrypt certificate for, and the email
# Let's Encrypt sends expiry/problem notices to. Must be a real domain already
# pointed at this VPS - Let's Encrypt's HTTP challenge will fail otherwise.
DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=CHANGE_ME@example.com

# --- Backups -------------------------------------------------------------------
# How many days of nightly pg_dump files to keep under the `backups` volume.
BACKUP_RETENTION_DAYS=14
