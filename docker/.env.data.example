# =============================================================================
# Ceylon Collection - data tier environment (docker/compose.data.yml)
# =============================================================================
# Copy to `.env.data` at the REPO ROOT on the VPS and fill in real values:
#
#     cp docker/.env.data.example .env.data
#
# `.env.data` is git-ignored and must never be committed. This example file is
# committed on purpose, so the required variables are always discoverable - it
# must only ever contain placeholders.
#
# This is only for the split deployment described in docs/DEPLOY-HOSTINGER.md,
# where the app runs on Hostinger and only PostgreSQL, Redis and the nightly
# backup run on this VPS. For the all-in-one VPS stack use
# docker/.env.production.example instead.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# The password the app will use. Generate a long one with no characters that
# need escaping inside a connection string:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# base64url is deliberate: it produces only A-Z a-z 0-9 - and _, all safe in a
# URL. A password containing @ or / silently breaks DATABASE_URL parsing, and
# the error names the host rather than the password.
POSTGRES_USER=ceylon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ceyloncollection

# --- Redis --------------------------------------------------------------------
# Redis has no users and no password by default. This is the whole credential,
# so generate it the same way and make it just as long.
REDIS_PASSWORD=CHANGE_ME

# --- Backups ------------------------------------------------------------------
# How long to keep dumps, and how often to take one. The defaults are 14 days
# and every 24 hours.
#
# The `backups` volume protects against a bad migration or an accidental
# DELETE. It does nothing if this VPS is lost, so copy a dump off the machine
# regularly - see docs/DEPLOYMENT.md.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
